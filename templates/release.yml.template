# =============================================================================
# Release Workflow Template for Rust/egui Desktop Apps
# =============================================================================
# Copy to .github/workflows/release.yml and replace all __PLACEHOLDERS__.
#
# Required files in your repo:
#   - Cargo.toml (version is auto-synced from git tag)
#   - assets/icon.icns (macOS app icon)
#   - assets/icon_256x256.png (Linux/AppImage icon)
#   - windows/AppxManifest.xml (MSIX manifest, Version="1.0.0.0" placeholder)
#   - windows/assets/ (Store tiles: Square150x150, Square310x310, etc.)
#   - screenshots/windows/ (5 PNG screenshots, 3840x2160)
#   - entitlements.plist (macOS DMG entitlements)
#   - entitlements-appstore.plist (macOS App Store entitlements)
#
# Required GitHub Secrets:
#   Apple: APPLE_API_KEY_P8, APPLE_API_KEY_ID, APPLE_API_ISSUER_ID
#   macOS: MACOS_CERTIFICATE, MACOS_CERTIFICATE_PASSWORD,
#          MACOS_INSTALLER_CERTIFICATE, MACOS_INSTALLER_CERTIFICATE_PASSWORD,
#          MACOS_DEVELOPER_ID_CERTIFICATE, MACOS_DEVELOPER_ID_CERTIFICATE_PASSWORD,
#          MACOS_PROVISIONING_PROFILE
#   MS Store: MSSTORE_TENANT_ID, MSSTORE_CLIENT_ID, MSSTORE_CLIENT_SECRET
#   Windows (optional): WINDOWS_CERTIFICATE, WINDOWS_CERTIFICATE_PASSWORD
#
# Required GitHub Variables:
#   MSSTORE_ENABLED = "true" (to enable Microsoft Store publishing)
#
# =============================================================================
# PLACEHOLDERS — search & replace these:
#
#   __APP_NAME__          e.g. eudamed2swissdamed
#   __APP_DISPLAY_NAME__  e.g. Eudamed2Swissdamed
#   __BUNDLE_ID__         e.g. com.ywesee.eudamed2swissdamed
#   __MSSTORE_APP_ID__    e.g. 9NH43R1CMKFN
#   __CATEGORY_MACOS__    e.g. public.app-category.business
#   __CATEGORY_MSSTORE__  e.g. BooksAndReference_EReader
#   __DESCRIPTION_DE__    German store description
#   __DESCRIPTION_EN__    English store description
#   __KEYWORDS_DE__       e.g. "EUDAMED", "Medizinprodukte", "UDI"
#   __KEYWORDS_EN__       e.g. "EUDAMED", "medical device", "UDI"
#   __CERT_NOTES__        Notes for Microsoft Store certification testers
#   __GITHUB_URL__        e.g. https://github.com/zdavatz/eudamed2swissdamed
#   __CONTACT_EMAIL__     e.g. zdavatz@ywesee.com
#   __COPYRIGHT__         e.g. Copyright 2026 ywesee GmbH
#   __LINUX_COMMENT__     .desktop file comment
#   __SCREENSHOT_FILES__  List of screenshot filenames
# =============================================================================

name: Release

on:
  push:
    tags: ['v*']

permissions:
  contents: write

jobs:
  build-macos:
    runs-on: macos-14
    steps:
      - uses: actions/checkout@v4

      - name: Sync Cargo.toml version from git tag
        run: |
          TAG_VERSION="${GITHUB_REF_NAME#v}"
          sed -i '' "s/^version = \".*\"/version = \"${TAG_VERSION}\"/" Cargo.toml
          echo "Version set to: $TAG_VERSION"

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: aarch64-apple-darwin,x86_64-apple-darwin

      - name: Build universal binary
        run: |
          cargo build --release --target aarch64-apple-darwin
          cargo build --release --target x86_64-apple-darwin
          lipo -create \
            target/aarch64-apple-darwin/release/__APP_NAME__ \
            target/x86_64-apple-darwin/release/__APP_NAME__ \
            -output target/release/__APP_NAME__-universal

      - name: Create .app bundle
        run: |
          APP="target/release/__APP_NAME__.app"
          rm -rf "$APP"
          mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
          cp target/release/__APP_NAME__-universal "$APP/Contents/MacOS/__APP_NAME__"
          cp assets/icon.icns "$APP/Contents/Resources/AppIcon.icns"
          VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')
          cat > "$APP/Contents/Info.plist" << EOF
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
              <key>CFBundleName</key><string>__APP_NAME__</string>
              <key>CFBundleDisplayName</key><string>__APP_NAME__</string>
              <key>CFBundleIdentifier</key><string>__BUNDLE_ID__</string>
              <key>CFBundleVersion</key><string>${VERSION}</string>
              <key>CFBundleShortVersionString</key><string>${VERSION}</string>
              <key>CFBundleExecutable</key><string>__APP_NAME__</string>
              <key>CFBundleIconFile</key><string>AppIcon</string>
              <key>CFBundlePackageType</key><string>APPL</string>
              <key>NSHighResolutionCapable</key><true/>
              <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
              <key>LSMinimumSystemVersion</key><string>11.0</string>
              <key>LSApplicationCategoryType</key><string>__CATEGORY_MACOS__</string>
          </dict>
          </plist>
          EOF

      - name: Import signing certificates
        if: env.MACOS_CERTIFICATE != ''
        env:
          MACOS_CERTIFICATE: ${{ secrets.MACOS_CERTIFICATE }}
          MACOS_CERTIFICATE_PASSWORD: ${{ secrets.MACOS_CERTIFICATE_PASSWORD }}
          MACOS_INSTALLER_CERTIFICATE: ${{ secrets.MACOS_INSTALLER_CERTIFICATE }}
          MACOS_INSTALLER_CERTIFICATE_PASSWORD: ${{ secrets.MACOS_INSTALLER_CERTIFICATE_PASSWORD }}
          MACOS_DEVELOPER_ID_CERTIFICATE: ${{ secrets.MACOS_DEVELOPER_ID_CERTIFICATE }}
          MACOS_DEVELOPER_ID_CERTIFICATE_PASSWORD: ${{ secrets.MACOS_DEVELOPER_ID_CERTIFICATE_PASSWORD }}
        run: |
          security create-keychain -p "" build.keychain
          security set-keychain-settings build.keychain
          security list-keychains -d user -s build.keychain

          echo "$MACOS_CERTIFICATE" | base64 --decode > app_cert.p12
          security import app_cert.p12 -k build.keychain -P "$MACOS_CERTIFICATE_PASSWORD" -T /usr/bin/codesign -T /usr/bin/productbuild
          rm app_cert.p12

          if [ -n "$MACOS_INSTALLER_CERTIFICATE" ]; then
            echo "$MACOS_INSTALLER_CERTIFICATE" | base64 --decode > installer_cert.p12
            security import installer_cert.p12 -k build.keychain -P "$MACOS_INSTALLER_CERTIFICATE_PASSWORD" -T /usr/bin/codesign -T /usr/bin/productbuild
            rm installer_cert.p12
          fi

          if [ -n "$MACOS_DEVELOPER_ID_CERTIFICATE" ]; then
            echo "$MACOS_DEVELOPER_ID_CERTIFICATE" | base64 --decode > devid_cert.p12
            security import devid_cert.p12 -k build.keychain -P "$MACOS_DEVELOPER_ID_CERTIFICATE_PASSWORD" -T /usr/bin/codesign -T /usr/bin/productbuild
            rm devid_cert.p12
          fi

          security set-key-partition-list -S apple-tool:,apple: -s -k "" build.keychain

          echo "Available signing identities:"
          security find-identity -v build.keychain

      - name: Code sign app for DMG (Developer ID)
        if: env.MACOS_CERTIFICATE != ''
        env:
          MACOS_CERTIFICATE: ${{ secrets.MACOS_CERTIFICATE }}
        run: |
          IDENTITY=$(security find-identity -v build.keychain | grep "Developer ID Application" | head -1 | sed 's/.*"\(.*\)"/\1/')
          if [ -z "$IDENTITY" ]; then
            echo "ERROR: No 'Developer ID Application' certificate found. Available identities:"
            security find-identity -v build.keychain
            exit 1
          fi
          echo "Signing with: $IDENTITY"
          codesign --force --options runtime \
            --sign "$IDENTITY" \
            --entitlements entitlements.plist \
            --deep \
            target/release/__APP_NAME__.app

      - name: Create DMG
        run: |
          VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')
          STAGING=$(mktemp -d)
          cp -R target/release/__APP_NAME__.app "$STAGING/"
          ln -s /Applications "$STAGING/Applications"
          hdiutil create -volname "__APP_NAME__" \
            -srcfolder "$STAGING" \
            -ov -format UDZO \
            "__APP_NAME__-${VERSION}-macos-universal.dmg"
          rm -rf "$STAGING"

      - name: Notarize DMG (if API key available)
        if: env.APPLE_API_KEY_P8 != ''
        env:
          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
          APPLE_API_ISSUER_ID: ${{ secrets.APPLE_API_ISSUER_ID }}
        run: |
          VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')
          DMG="__APP_NAME__-${VERSION}-macos-universal.dmg"

          mkdir -p ~/.private_keys
          echo "$APPLE_API_KEY_P8" | base64 --decode > ~/.private_keys/AuthKey_${APPLE_API_KEY_ID}.p8

          xcrun notarytool submit "$DMG" \
            --key ~/.private_keys/AuthKey_${APPLE_API_KEY_ID}.p8 \
            --key-id "$APPLE_API_KEY_ID" \
            --issuer "$APPLE_API_ISSUER_ID" \
            --wait
          xcrun stapler staple "$DMG"

      - name: Upload macOS DMG artifact
        uses: actions/upload-artifact@v4
        with:
          name: macos-dmg
          path: __APP_NAME__-*-macos-universal.dmg

      - name: Build App Store package (if API key available)
        if: env.APPLE_API_KEY_P8 != ''
        env:
          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
          APPLE_API_ISSUER_ID: ${{ secrets.APPLE_API_ISSUER_ID }}
          MACOS_PROVISIONING_PROFILE: ${{ secrets.MACOS_PROVISIONING_PROFILE }}
        run: |
          VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')
          APP="target/release/__APP_NAME__.app"

          if [ -n "$MACOS_PROVISIONING_PROFILE" ]; then
            echo "$MACOS_PROVISIONING_PROFILE" | base64 --decode > "$APP/Contents/embedded.provisionprofile"
            echo "Embedded provisioning profile"
          fi

          APP_IDENTITY=$(security find-identity -v build.keychain | grep "Mac App Distribution\|3rd Party Mac Developer Application" | head -1 | sed 's/.*"\(.*\)"/\1/' || true)
          if [ -n "$APP_IDENTITY" ]; then
            echo "Signing app with: $APP_IDENTITY"
            codesign --force --options runtime \
              --sign "$APP_IDENTITY" \
              --entitlements entitlements-appstore.plist \
              --deep \
              "$APP"
          fi

          INSTALLER_IDENTITY=$(security find-identity -v build.keychain | grep "Mac Installer Distribution\|3rd Party Mac Developer Installer" | head -1 | sed 's/.*"\(.*\)"/\1/' || true)
          if [ -n "$INSTALLER_IDENTITY" ]; then
            echo "Signing pkg with: $INSTALLER_IDENTITY"
            productbuild --component "$APP" /Applications \
              --sign "$INSTALLER_IDENTITY" \
              "__APP_NAME__-${VERSION}-macos-appstore.pkg"
          else
            productbuild --component "$APP" /Applications \
              "__APP_NAME__-${VERSION}-macos-appstore.pkg"
          fi

          mkdir -p ~/.private_keys
          echo "$APPLE_API_KEY_P8" | base64 --decode > ~/.private_keys/AuthKey_${APPLE_API_KEY_ID}.p8

          TRANSPORTER="/Applications/Transporter.app/Contents/itms/bin/iTMSTransporter"
          if [ -x "$TRANSPORTER" ]; then
            echo "Using iTMSTransporter"
            "$TRANSPORTER" -m upload \
              -f "__APP_NAME__-${VERSION}-macos-appstore.pkg" \
              -apiKey "$APPLE_API_KEY_ID" \
              -apiIssuer "$APPLE_API_ISSUER_ID" || echo "WARNING: iTMSTransporter upload failed"
          else
            echo "iTMSTransporter not found, using altool"
            xcrun altool --upload-app \
              --file "__APP_NAME__-${VERSION}-macos-appstore.pkg" \
              --type macos \
              --apiKey "$APPLE_API_KEY_ID" \
              --apiIssuer "$APPLE_API_ISSUER_ID" || echo "WARNING: App Store upload failed"
          fi

      - name: Upload App Store pkg artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: macos-appstore-pkg
          path: __APP_NAME__-*-macos-appstore.pkg
          if-no-files-found: ignore

  build-linux:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4

      - name: Sync Cargo.toml version from git tag
        run: |
          TAG_VERSION="${GITHUB_REF_NAME#v}"
          sed -i "s/^version = \".*\"/version = \"${TAG_VERSION}\"/" Cargo.toml
          echo "Version set to: $TAG_VERSION"

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Install Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libgtk-3-dev libxcb-render0-dev libxcb-shape0-dev libxcb-xfixes0-dev libxkbcommon-dev libssl-dev libfuse2

      - name: Build
        run: cargo build --release

      - name: Create tar.gz
        run: |
          VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')
          mkdir -p dist/__APP_NAME__
          cp target/release/__APP_NAME__ dist/__APP_NAME__/
          cp config.toml dist/__APP_NAME__/ 2>/dev/null || true
          cp README.md dist/__APP_NAME__/
          tar -czf "__APP_NAME__-${VERSION}-linux-x86_64.tar.gz" -C dist __APP_NAME__

      - name: Create AppImage
        run: |
          VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/')

          wget -q "https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage" -O appimagetool
          chmod +x appimagetool

          mkdir -p AppDir/usr/bin AppDir/usr/share/icons/hicolor/256x256/apps AppDir/usr/share/applications

          cp target/release/__APP_NAME__ AppDir/usr/bin/
          cp assets/icon_256x256.png AppDir/usr/share/icons/hicolor/256x256/apps/__APP_NAME__.png 2>/dev/null || true
          cp assets/icon_256x256.png AppDir/__APP_NAME__.png 2>/dev/null || true

          cat > AppDir/__APP_NAME__.desktop << DESKTOP
          [Desktop Entry]
          Name=__APP_NAME__
          Exec=__APP_NAME__
          Icon=__APP_NAME__
          Type=Application
          Categories=Office;
          Comment=__LINUX_COMMENT__
          DESKTOP

          cat > AppDir/AppRun << 'APPRUN'
          #!/bin/bash
          SELF=$(readlink -f "$0")
          HERE=${SELF%/*}
          export PATH="${HERE}/usr/bin:${PATH}"
          exec "${HERE}/usr/bin/__APP_NAME__" "$@"
          APPRUN
          chmod +x AppDir/AppRun

          ARCH=x86_64 ./appimagetool AppDir "__APP_NAME__-${VERSION}-linux-x86_64.AppImage"

      - name: Upload Linux artifacts
        uses: actions/upload-artifact@v4
        with:
          name: linux-packages
          path: |
            __APP_NAME__-*-linux-x86_64.tar.gz
            __APP_NAME__-*-linux-x86_64.AppImage

  build-windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Sync Cargo.toml version from git tag
        shell: bash
        run: |
          TAG_VERSION="${GITHUB_REF_NAME#v}"
          sed -i "s/^version = \".*\"/version = \"${TAG_VERSION}\"/" Cargo.toml
          echo "Version set to: $TAG_VERSION"

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Build
        run: cargo build --release

      - name: Create portable ZIP
        shell: pwsh
        run: |
          $version = (Select-String -Path Cargo.toml -Pattern '^version = "(.+)"' | Select-Object -First 1).Matches.Groups[1].Value
          New-Item -ItemType Directory -Force -Path dist
          Copy-Item target\release\__APP_NAME__.exe dist\
          Compress-Archive -Path dist\* -DestinationPath "__APP_NAME__-${version}-windows-x64.zip"

      - name: Create MSIX package
        shell: pwsh
        run: |
          $version = (Select-String -Path Cargo.toml -Pattern '^version = "(.+)"' | Select-Object -First 1).Matches.Groups[1].Value

          $sdkBin = Get-ChildItem "C:\Program Files (x86)\Windows Kits\10\bin\10.*\x64\makeappx.exe" -ErrorAction SilentlyContinue | Sort-Object -Descending | Select-Object -First 1
          if (-not $sdkBin) {
            Write-Error "makeappx.exe not found in Windows SDK"
            exit 1
          }
          $sdkDir = $sdkBin.DirectoryName
          Write-Host "Using Windows SDK at: $sdkDir"

          $msixDir = "msix_staging"
          New-Item -ItemType Directory -Force -Path $msixDir
          Copy-Item target\release\__APP_NAME__.exe $msixDir\

          $manifest = Get-Content windows\AppxManifest.xml -Raw
          $manifest = $manifest -replace 'Version="1\.0\.0\.0"', "Version=`"${version}.0`""
          Set-Content -Path "$msixDir\AppxManifest.xml" -Value $manifest

          New-Item -ItemType Directory -Force -Path "$msixDir\assets"
          Copy-Item windows\assets\* "$msixDir\assets\"

          & "$sdkDir\makeappx.exe" pack /d $msixDir /p "__APP_NAME__-${version}-windows-x64.msix" /o

      - name: Sign MSIX (if certificate available)
        if: env.WINDOWS_CERTIFICATE != ''
        shell: pwsh
        env:
          WINDOWS_CERTIFICATE: ${{ secrets.WINDOWS_CERTIFICATE }}
          WINDOWS_CERTIFICATE_PASSWORD: ${{ secrets.WINDOWS_CERTIFICATE_PASSWORD }}
        run: |
          $version = (Select-String -Path Cargo.toml -Pattern '^version = "(.+)"' | Select-Object -First 1).Matches.Groups[1].Value
          $sdkBin = Get-ChildItem "C:\Program Files (x86)\Windows Kits\10\bin\10.*\x64\signtool.exe" -ErrorAction SilentlyContinue | Sort-Object -Descending | Select-Object -First 1
          $certBytes = [Convert]::FromBase64String($env:WINDOWS_CERTIFICATE)
          [IO.File]::WriteAllBytes("cert.pfx", $certBytes)
          & $sdkBin.FullName sign /fd SHA256 /a /f cert.pfx /p $env:WINDOWS_CERTIFICATE_PASSWORD "__APP_NAME__-${version}-windows-x64.msix"
          Remove-Item cert.pfx

      - name: Upload Windows artifacts
        uses: actions/upload-artifact@v4
        with:
          name: windows-packages
          path: |
            __APP_NAME__-*-windows-x64.zip
            __APP_NAME__-*-windows-x64.msix

  release:
    needs: [build-macos, build-windows, build-linux]
    if: always() && (needs.build-windows.result == 'success' || needs.build-linux.result == 'success')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          files: |
            artifacts/macos-dmg/*.dmg
            artifacts/windows-packages/*.zip
            artifacts/windows-packages/*.msix
            artifacts/linux-packages/*.tar.gz
            artifacts/linux-packages/*.AppImage
          generate_release_notes: true

  publish-microsoft-store:
    needs: [build-windows]
    runs-on: windows-latest
    if: vars.MSSTORE_ENABLED == 'true'
    steps:
      - uses: actions/checkout@v4

      - name: Download Windows artifacts
        uses: actions/download-artifact@v4
        with:
          name: windows-packages
          path: artifacts

      - name: Publish to Microsoft Store
        shell: pwsh
        env:
          MSSTORE_TENANT_ID: ${{ secrets.MSSTORE_TENANT_ID }}
          MSSTORE_CLIENT_ID: ${{ secrets.MSSTORE_CLIENT_ID }}
          MSSTORE_CLIENT_SECRET: ${{ secrets.MSSTORE_CLIENT_SECRET }}
        run: |
          $msix = Get-ChildItem artifacts/*.msix | Select-Object -First 1
          Write-Host "Submitting: $($msix.FullName)"

          # Get OAuth2 token from Azure AD
          $tokenBody = @{
            grant_type    = "client_credentials"
            client_id     = $env:MSSTORE_CLIENT_ID
            client_secret = $env:MSSTORE_CLIENT_SECRET
            resource      = "https://manage.devcenter.microsoft.com"
          }
          $tokenResp = Invoke-RestMethod -Method Post `
            -Uri "https://login.microsoftonline.com/$($env:MSSTORE_TENANT_ID)/oauth2/token" `
            -Body $tokenBody
          $token = $tokenResp.access_token
          Write-Host "Got access token"

          $headers = @{
            Authorization = "Bearer $token"
            "Content-Type" = "application/json"
          }

          # Get app info and current submission
          $appId = "__MSSTORE_APP_ID__"
          $appResp = Invoke-RestMethod -Method Get `
            -Uri "https://manage.devcenter.microsoft.com/v1.0/my/applications/$appId" `
            -Headers $headers
          Write-Host "App: $($appResp.primaryName)"

          # If there's a pending submission, delete it
          if ($appResp.pendingApplicationSubmission) {
            $pendingId = $appResp.pendingApplicationSubmission.id
            Write-Host "Deleting pending submission: $pendingId"
            Invoke-RestMethod -Method Delete `
              -Uri "https://manage.devcenter.microsoft.com/v1.0/my/applications/$appId/submissions/$pendingId" `
              -Headers $headers
          }

          # Create new submission (clones the last published one)
          $subResp = Invoke-RestMethod -Method Post `
            -Uri "https://manage.devcenter.microsoft.com/v1.0/my/applications/$appId/submissions" `
            -Headers $headers
          $subId = $subResp.id
          $uploadUrl = $subResp.fileUploadUrl
          Write-Host "Created submission: $subId"
          Write-Host "Upload URL available: $($uploadUrl.Length -gt 0)"

          # Update submission: add our MSIX package and set required fields
          $submission = $subResp
          $msixFileName = $msix.Name

          # Set application category (required)
          $submission.applicationCategory = "__CATEGORY_MSSTORE__"

          # Set target device families
          $submission.allowTargetFutureDeviceFamilies = @{
            Desktop = $true
            Mobile = $false
            Xbox = $false
            Holographic = $false
          }
          $submission.allowMicrosoftDecideAppAvailabilityToFutureDeviceFamilies = $true

          # Screenshots
          $screenshotFiles = @(
            __SCREENSHOT_FILES__
          )
          $images = @()
          foreach ($ss in $screenshotFiles) {
            $images += @{
              fileName = $ss
              fileStatus = "PendingUpload"
              imageType = "Screenshot"
            }
          }

          $releaseNotes = "$env:GITHUB_REF_NAME`: $(git log -1 --format=%s)"

          # Submission-level questionnaire fields
          $submission.hasExternalInAppProducts = $false
          $submission.meetAccessibilityGuidelines = $true
          $submission.canInstallOnRemovableMedia = $true
          $submission.automaticBackupEnabled = $true
          $submission.hardwarePreferences = @("Keyboard", "Mouse")
          $submission.notesForCertification = "__CERT_NOTES__"

          # Store listings (German + English)
          $submission.listings = @{
            "de-de" = @{
              baseListing = @{
                title = "__APP_DISPLAY_NAME__"
                description = "__DESCRIPTION_DE__"
                releaseNotes = $releaseNotes
                keywords = @(__KEYWORDS_DE__)
                copyrightAndTrademarkInfo = "__COPYRIGHT__"
                licenseTerms = "GNU General Public License v3.0"
                privacyPolicy = "__GITHUB_URL__"
                websiteUrl = "__GITHUB_URL__"
                supportContact = "__CONTACT_EMAIL__"
                images = $images
              }
            }
            "en-us" = @{
              baseListing = @{
                title = "__APP_DISPLAY_NAME__"
                description = "__DESCRIPTION_EN__"
                releaseNotes = $releaseNotes
                keywords = @(__KEYWORDS_EN__)
                copyrightAndTrademarkInfo = "__COPYRIGHT__"
                licenseTerms = "GNU General Public License v3.0"
                privacyPolicy = "__GITHUB_URL__"
                websiteUrl = "__GITHUB_URL__"
                supportContact = "__CONTACT_EMAIL__"
                images = $images
              }
            }
          }

          # Remove old packages (mark as PendingDelete)
          if ($submission.applicationPackages) {
            foreach ($pkg in $submission.applicationPackages) {
              $pkg.fileStatus = "PendingDelete"
            }
          } else {
            $submission.applicationPackages = @()
          }

          # Add our new package
          $newPackage = @{
            fileName = $msixFileName
            fileStatus = "PendingUpload"
            minimumDirectXVersion = "None"
            minimumSystemRam = "None"
          }
          $submission.applicationPackages += $newPackage

          # PUT the updated submission JSON
          $updateBody = $submission | ConvertTo-Json -Depth 20 -Compress
          Invoke-RestMethod -Method Put `
            -Uri "https://manage.devcenter.microsoft.com/v1.0/my/applications/$appId/submissions/$subId" `
            -Headers $headers `
            -Body $updateBody `
            -ContentType "application/json; charset=utf-8"
          Write-Host "Updated submission with package: $msixFileName"

          # Upload MSIX + screenshots as ZIP to the Azure Blob upload URL
          # The ZIP must contain the MSIX and screenshot files with exact names
          $zipPath = [System.IO.Path]::Combine($env:TEMP, "upload.zip")
          $zipItems = @($msix.FullName)
          foreach ($ss in $screenshotFiles) {
            $ssPath = Join-Path "screenshots" "windows" $ss
            if (Test-Path $ssPath) { $zipItems += (Resolve-Path $ssPath).Path }
          }
          Compress-Archive -Path $zipItems -DestinationPath $zipPath -Force
          $zipBytes = [System.IO.File]::ReadAllBytes($zipPath)
          Invoke-RestMethod -Method Put -Uri $uploadUrl `
            -Headers @{"x-ms-blob-type" = "BlockBlob"} `
            -Body $zipBytes `
            -ContentType "application/octet-stream"
          Write-Host "Uploaded package ZIP ($([math]::Round($zipBytes.Length/1MB, 2)) MB)"

          # Commit the submission
          $commitResp = Invoke-RestMethod -Method Post `
            -Uri "https://manage.devcenter.microsoft.com/v1.0/my/applications/$appId/submissions/$subId/commit" `
            -Headers $headers
          Write-Host "Submission committed: $subId"
          Write-Host "Commit status: $($commitResp.status)"
